# ── License ───────────────────────────────────────────────────────────────────
# Provided at contract signing. Required — app refuses to start without it.
LICENSE_KEY=

# ── Published ports ───────────────────────────────────────────────────────────
# Host-side ports — change if any of these conflict with something else already
# running on your server. Container-side ports are fixed and not configurable.
API_PORT=8000
CONNECTOR_PORT=8001
FRONTEND_PORT=3000
SUPERADMIN_PORT=3001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Application ───────────────────────────────────────────────────────────────
APP_PRODUCTION=true

# Requires a step-up email code on login from a new IP. Keep this true for any
# real installation — only disable for internal testing.
LOGIN_VERIFICATION_ENABLED=true

# Public domain of the main CRM
BASE_DOMAIN=

# Public domain of the super admin panel
SUPER_ADMIN_DOMAIN=

# Required — must list the exact origins your frontend and super admin panel are served from 
CORS_ORIGINS=
CORS_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# If you run a reverse proxy (nginx/Caddy/Traefik) in front of this stack, set this to
# its IP/CIDR so login/audit logs see your users' real IPs instead of the proxy's.
# Leave empty if you're not using a reverse proxy, or aren't sure.
TRUSTED_PROXIES=

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=player_pulse
DB_USER=player_pulse
DB_PASSWORD=          # generated by install.sh — can be provided manually
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=       # generated by install.sh — can be provided manually
REDIS_USERNAME=       # optional — leave empty unless your Redis setup requires it
REDIS_MAX_MEMORY=256mb
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_MIN_RETRY_BACKOFF=8ms
REDIS_MAX_RETRY_BACKOFF=512ms
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_MAX_CONN_AGE=1h
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# ── Auth ──────────────────────────────────────────────────────────────────────
SIGNING_KEY=          # generated by install.sh — can be provided manually
ACCESS_TOKEN_EXPIRATION_DURATION=15m
REFRESH_TOKEN_EXPIRATION_DURATION=168h

# ── Bootstrap super admin ───────────────────────────────────────────────────────
# Created automatically on first migrate:up if super_admins is empty. Email is
# provided by you at install time; password is generated by install.sh — log in
# and change it immediately afterward.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=     # generated by install.sh — can be provided manually

# ── PII encryption ────────────────────────────────────────────────────────────
# WARNING: back this up externally before doing anything else.
# Loss of this key = permanent loss of all encrypted player PII. Unrecoverable.
PII_MASTER_KEY=       # generated by install.sh — can be provided manually

# ── Object storage ────────────────────────────────────────────────────────────
# MinIO is bundled by default. To use an external provider (AWS S3, R2, etc.)
# point S3_ENDPOINT at your provider and remove minio + minio-init from compose.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=player-pulse
S3_USE_ACL=false
# Set to your MinIO public domain so file URLs are accessible from the browser
S3_PUBLIC_URL=

# MinIO root/admin credentials — used only once at first startup by minio-init
# to bootstrap the bucket and the scoped app user below. The app never uses these.
MINIO_ROOT_USER=      # generated by install.sh — can be provided manually
MINIO_ROOT_PASSWORD=  # generated by install.sh — can be provided manually

# App's actual S3 credentials — scoped to the player-pulse bucket only, created
# by minio-init on first startup. This is what api/connector actually use.
S3_ACCESS_KEY=        # generated by install.sh — can be provided manually
S3_SECRET_KEY=        # generated by install.sh — can be provided manually

# ── Email ─────────────────────────────────────────────────────────────────────
# MAIL_PROVIDER selects how the app sends email: "mailgun" (default) or "smtp".
# Use smtp to point at your own mail server, or any provider that exposes an SMTP
# relay (SendGrid, Amazon SES, Postmark, Google Workspace, etc.) — you're not
# required to set up a Mailgun account for an on-premise install.
MAIL_PROVIDER=mailgun
MAIL_SENDER_EMAIL=
MAIL_SIGNING_KEY=     # generated by install.sh — can be provided manually
MAIL_RESET_EXPIRATION_DURATION=4h

# Required only if MAIL_PROVIDER=mailgun
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_REGION=

# Required only if MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_IP_WINDOW=1m
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW=1m
RATE_LIMIT_PROJECT_MAX=1000
RATE_LIMIT_PROJECT_WINDOW=1m